# Copy to .env and fill in real values. Never commit .env.

# --- Django core ---------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database ------------------------------------------------------------
# Leave unset to use the local SQLite file.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Twilio (SMS / WhatsApp notifications) -------------------------------
# Leave TWILIO_ENABLED=False to skip sending entirely (nothing is billed).
TWILIO_ENABLED=False
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
SMS_DEFAULT_COUNTRY_CODE=+91

# --- Firebase Cloud Messaging (web push) ---------------------------------
FCM_SERVER_KEY=

# --- Outgoing mail -------------------------------------------------------
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# --- Docker deployment ---------------------------------------------------
# Used by docker-compose.yml. POSTGRES_PASSWORD has no default on purpose:
# compose refuses to start until you choose one.
POSTGRES_DB=skillycms
POSTGRES_USER=skillycms
POSTGRES_PASSWORD=
# The address people will type. Without this Django answers DisallowedHost.
ALLOWED_HOSTS=localhost,127.0.0.1
# Required when served over HTTPS, e.g. https://portal.yourcollege.ac.in
CSRF_TRUSTED_ORIGINS=
BEHIND_TLS_PROXY=False
# Host port to publish the app on.
PORT=8000
